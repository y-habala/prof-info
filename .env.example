# Supabase project settings — see README for setup instructions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL, only for scripts/migrate.mjs (see README). Use the
# Supavisor pooler host from Project Settings > Database > Connect, not
# db.<ref>.supabase.co — that one is IPv6-only and often unreachable.
SUPABASE_DB_URL=

# Random secret signing the student access-session JWT. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_SESSION_SECRET=
